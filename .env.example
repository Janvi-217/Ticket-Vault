# Frontend: set to your backend's public origin in Netlify.
# Leave empty for local development when the Express server serves the Vite app.
VITE_API_BASE_URL=

# Backend only: Firebase Admin service-account credentials.
# Never put these values in VITE_ variables or commit real credentials.
FIREBASE_PROJECT_ID=ticket-vault-a0426
FIREBASE_CLIENT_EMAIL=your-service-account-email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\nYOUR_PRIVATE_KEY\\n-----END PRIVATE KEY-----\\n"
PORT=3000
# Set this to your Netlify site URL on the backend host.
CLIENT_URL=http://localhost:3000
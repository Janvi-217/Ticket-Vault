# Firebase Web App configuration (Firebase Console > Project settings > Your apps)
VITE_FIREBASE_API_KEY=your-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# Server-side secrets. Set only in Netlify environment variables / local Netlify CLI.
GEMINI_API_KEY=your-google-ai-studio-key
# JSON content of a Firebase service account key; used only to verify AI endpoint ID tokens.
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-project-id"}
